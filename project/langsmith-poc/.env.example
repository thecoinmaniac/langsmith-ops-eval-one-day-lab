# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=***
LANGSMITH_PROJECT=poc-langsmith-dev

# LLM Provider (OpenAI-compatible; choose one you use)
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=***
OPENAI_API_KEY=***

# App settings
POC_USE_CASE=ops_reflection
POC_MODEL=minimax-m2.7
POC_DATASET_NAME=ops-reflections-golden-v1
POC_EXPERIMENT_PREFIX=ops-reflections

# Evaluation realism control
# false (recommended): do not inject must_include keywords into prompts
# true: deterministic keyword pass mode (use for debugging only)
POC_INJECT_REQUIRED_TERMS_IN_PROMPT=false
